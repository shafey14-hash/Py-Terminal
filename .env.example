# ---- Backend server ----
PORT=4000
ALLOWED_ORIGINS=http://localhost:5173,https://your-frontend.vercel.app

# ---- Gemini AI assistant (optional) ----
# Get a key at https://aistudio.google.com/app/apikey
# Leave blank to disable the AI panel gracefully (it will show "not configured").
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ---- Python execution provider ----
# Public Piston instance by default. See /execution/README.md before relying on this
# in production - it is rate limited and has no scientific-computing packages installed.
EXECUTION_API_URL=https://emkc.org/api/v2/piston
EXECUTION_API_KEY=

# ---- Limits (all optional, sane defaults applied if omitted) ----
MAX_FILE_COUNT=60
MAX_FILE_SIZE_BYTES=1000000
MAX_PROJECT_SIZE_BYTES=5000000
MAX_TIMEOUT_MS=10000
RUN_RATE_LIMIT_PER_MIN=20
AI_RATE_LIMIT_PER_MIN=15